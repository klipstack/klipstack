{
	"extends": "../../tsconfig.base.json",
	"include": ["**/*", "**/.server/**/*", "**/.client/**/*", ".react-router/types/**/*"],
	"exclude": ["node_modules", "build", "playwright-report", "test-results"],
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2023"],
		"types": ["node", "vite/client"],
		"jsx": "react-jsx",
		"rootDirs": [".", "./.react-router/types"],
		"paths": { "~/*": ["./app/*"] }
	}
}
