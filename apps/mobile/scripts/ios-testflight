#!/usr/bin/env bash
# Build the release app and upload it to App Store Connect, for TestFlight: `pnpm ios:testflight`.
#
# Signs with the team in APPLE_TEAM_ID (.env.local) and uploads with the Apple account signed in
# to Xcode (Settings → Accounts), which must belong to that team as Admin or App Manager. Xcode
# creates the distribution certificate and profiles the first time. The build number is the time
# (yymmdd.HHMMSS, UTC), so each upload is higher than the last. The version is app.json's `version`.
set -euo pipefail
cd "$(dirname "$0")/.."
export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8

# The last APPLE_TEAM_ID= line, without quotes, a trailing comment or a carriage return.
team=$(sed -nE 's/^APPLE_TEAM_ID=["'"'"']?([A-Z0-9]+).*$/\1/p' .env.local 2>/dev/null | tail -n 1)
if [ -z "$team" ]; then
  echo "No APPLE_TEAM_ID in apps/mobile/.env.local: uploads need the paid team." >&2
  exit 1
fi
# The date, then the time of day as a number without leading zeros (Apple wants plain integers):
# 0.1.0 (261019.92233) at 09:22:33 UTC. Two runs a second apart get different numbers.
export IOS_BUILD_NUMBER=${IOS_BUILD_NUMBER:-$(date -u +%y%m%d).$((10#$(date -u +%H%M%S)))}
version=$(node -p 'require("./app.json").expo.version')

out=build/testflight/$version-$IOS_BUILD_NUMBER
mkdir -p "$out"
log=$out/log.txt
step() {
  local name=$1
  shift
  printf '  %-28s' "$name"
  if "$@" >>"$log" 2>&1; then
    echo ok
  else
    printf 'FAIL\n\n'
    tail -n 40 "$log"
    printf '\nFull log: %s\n' "$log"
    exit 1
  fi
}

cat >"$out/ExportOptions.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key><string>app-store-connect</string>
	<key>destination</key><string>${UPLOAD_DESTINATION:-upload}</string>
	<key>teamID</key><string>$team</string>
	<key>signingStyle</key><string>automatic</string>
	<key>manageAppVersionAndBuildNumber</key><false/>
</dict>
</plist>
PLIST

echo "Klipstack $version ($IOS_BUILD_NUMBER), team $team, from $(git rev-parse --short HEAD)$([ -z "$(git status --porcelain -- .)" ] || echo ' with uncommitted changes')"
# --clean: a native project made from scratch, so nothing from development builds ends up in it.
step "native project" env EXPO_NO_GIT_STATUS=1 pnpm expo prebuild -p ios --clean
step "archive (signing)" xcodebuild -workspace ios/Klipstack.xcworkspace -scheme Klipstack \
  -configuration Release -destination generic/platform=iOS -archivePath "$out/Klipstack.xcarchive" \
  -allowProvisioningUpdates archive
step "export and upload" xcodebuild -exportArchive -archivePath "$out/Klipstack.xcarchive" \
  -exportOptionsPlist "$out/ExportOptions.plist" -exportPath "$out" -allowProvisioningUpdates
echo "Done. App Store Connect → Klipstack → TestFlight shows the build once Apple has processed it."
