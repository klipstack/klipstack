{
	"expo": {
		"name": "Klipstack",
		"slug": "klipstack",
		"scheme": ["klipstack", "com.klipstack.app"],
		"version": "0.1.0",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "automatic",
		"locales": {
			"es": "./locales/es.json"
		},
		"ios": {
			"bundleIdentifier": "com.klipstack.mobile",
			"supportsTablet": false,
			"usesAppleSignIn": true,
			"associatedDomains": ["applinks:klipstack.com", "webcredentials:klipstack.com"],
			"entitlements": {
				"com.apple.security.application-groups": ["group.com.klipstack"]
			},
			"infoPlist": {
				"UIBackgroundModes": ["audio"],
				"NSMicrophoneUsageDescription": "Klipstack listens while you dictate a note.",
				"NSSpeechRecognitionUsageDescription": "Klipstack turns what you dictate into your note, on this iPhone.",
				"NSPhotoLibraryUsageDescription": "Klipstack doesn't read your photo library. It only saves the highlight images you choose to save.",
				"NSPhotoLibraryAddUsageDescription": "Klipstack saves highlight images you share to your photos.",
				"ITSAppUsesNonExemptEncryption": false
			},
			"privacyManifests": {
				"NSPrivacyTracking": false,
				"NSPrivacyTrackingDomains": [],
				"NSPrivacyAccessedAPITypes": [
					{
						"NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
						"NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
					},
					{
						"NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
						"NSPrivacyAccessedAPITypeReasons": ["CA92.1", "1C8F.1"]
					},
					{
						"NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
						"NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
					},
					{
						"NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
						"NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
					}
				],
				"NSPrivacyCollectedDataTypes": [
					{
						"NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
						"NSPrivacyCollectedDataTypeLinked": true,
						"NSPrivacyCollectedDataTypeTracking": false,
						"NSPrivacyCollectedDataTypePurposes": [
							"NSPrivacyCollectedDataTypePurposeAppFunctionality"
						]
					},
					{
						"NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
						"NSPrivacyCollectedDataTypeLinked": true,
						"NSPrivacyCollectedDataTypeTracking": false,
						"NSPrivacyCollectedDataTypePurposes": [
							"NSPrivacyCollectedDataTypePurposeAppFunctionality"
						]
					},
					{
						"NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
						"NSPrivacyCollectedDataTypeLinked": true,
						"NSPrivacyCollectedDataTypeTracking": false,
						"NSPrivacyCollectedDataTypePurposes": [
							"NSPrivacyCollectedDataTypePurposeAppFunctionality"
						]
					},
					{
						"NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
						"NSPrivacyCollectedDataTypeLinked": true,
						"NSPrivacyCollectedDataTypeTracking": false,
						"NSPrivacyCollectedDataTypePurposes": [
							"NSPrivacyCollectedDataTypePurposeAppFunctionality"
						]
					},
					{
						"NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeProductInteraction",
						"NSPrivacyCollectedDataTypeLinked": true,
						"NSPrivacyCollectedDataTypeTracking": false,
						"NSPrivacyCollectedDataTypePurposes": [
							"NSPrivacyCollectedDataTypePurposeAppFunctionality",
							"NSPrivacyCollectedDataTypePurposeAnalytics"
						]
					},
					{
						"NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeBrowsingHistory",
						"NSPrivacyCollectedDataTypeLinked": true,
						"NSPrivacyCollectedDataTypeTracking": false,
						"NSPrivacyCollectedDataTypePurposes": [
							"NSPrivacyCollectedDataTypePurposeAppFunctionality"
						]
					},
					{
						"NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeSearchHistory",
						"NSPrivacyCollectedDataTypeLinked": true,
						"NSPrivacyCollectedDataTypeTracking": false,
						"NSPrivacyCollectedDataTypePurposes": [
							"NSPrivacyCollectedDataTypePurposeAppFunctionality"
						]
					}
				]
			}
		},
		"android": {
			"package": "com.klipstack.mobile",
			"adaptiveIcon": {
				"backgroundColor": "#132548",
				"foregroundImage": "./assets/android-icon-foreground.png",
				"backgroundImage": "./assets/android-icon-background.png",
				"monochromeImage": "./assets/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false
		},
		"plugins": [
			"expo-router",
			"expo-secure-store",
			"expo-web-browser",
			"expo-apple-authentication",
			"@bacons/apple-targets",
			"./plugins/with-extension-settings",
			["expo-localization", { "supportedLocales": { "ios": ["en", "es"] } }],
			[
				"expo-font",
				{
					"fonts": [
						"./assets/fonts/Newsreader-Regular.ttf",
						"./assets/fonts/Newsreader-Italic.ttf",
						"./assets/fonts/Newsreader-Medium.ttf"
					]
				}
			],
			[
				"expo-build-properties",
				{
					"ios": {
						"deploymentTarget": "17.4",
						"enableSceneSupport": true
					}
				}
			],
			[
				"expo-splash-screen",
				{
					"image": "./assets/splash-logo.png",
					"imageWidth": 220,
					"backgroundColor": "#fbfaf7",
					"dark": {
						"image": "./assets/splash-logo-dark.png",
						"backgroundColor": "#1a1511"
					}
				}
			]
		],
		"experiments": {
			"typedRoutes": true
		}
	}
}
