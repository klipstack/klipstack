{
	"expo": {
		"name": "Klipstack",
		"slug": "klipstack",
		"scheme": "klipstack",
		"version": "0.1.0",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "automatic",
		"ios": {
			"bundleIdentifier": "com.klipstack.app",
			"supportsTablet": true,
			"entitlements": {
				"com.apple.security.application-groups": ["group.com.klipstack.app"]
			},
			"infoPlist": {
				"UIBackgroundModes": ["audio"],
				"NSMicrophoneUsageDescription": "Klipstack listens while you dictate a note.",
				"NSSpeechRecognitionUsageDescription": "Klipstack turns what you dictate into your note, on this iPhone."
			}
		},
		"android": {
			"package": "com.klipstack.app",
			"adaptiveIcon": {
				"backgroundColor": "#132548",
				"foregroundImage": "./assets/android-icon-foreground.png",
				"backgroundImage": "./assets/android-icon-background.png",
				"monochromeImage": "./assets/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false
		},
		"plugins": [
			"expo-router",
			"expo-secure-store",
			"expo-web-browser",
			"@bacons/apple-targets",
			[
				"expo-font",
				{
					"fonts": [
						"./assets/fonts/Newsreader-Regular.ttf",
						"./assets/fonts/Newsreader-Italic.ttf",
						"./assets/fonts/Newsreader-Medium.ttf"
					]
				}
			],
			["expo-build-properties", { "ios": { "enableSceneSupport": true } }],
			[
				"expo-splash-screen",
				{
					"image": "./assets/splash-logo.png",
					"imageWidth": 220,
					"backgroundColor": "#fbfaf7",
					"dark": {
						"image": "./assets/splash-logo-dark.png",
						"backgroundColor": "#1a1511"
					}
				}
			]
		],
		"experiments": {
			"typedRoutes": true
		}
	}
}
