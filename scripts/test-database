#!/usr/bin/env bash
# scripts/test-database ADMIN_URL create|drop|list NAME: an empty database for tests, on the local
# PostgreSQL that ADMIN_URL reaches, made as CI and production make theirs. `list PREFIX` prints the
# databases whose names start with PREFIX. Used by scripts/ci-local and scripts/verify, whose tests
# then run on it rather than on the database in .env.
set -euo pipefail
case ${2:-} in
  create|drop|list) ;;
  *) echo "usage: scripts/test-database ADMIN_URL create|drop|list NAME" >&2; exit 2 ;;
esac
cd "$(git rev-parse --show-toplevel)/packages/db"
node -e '
  const { Client } = require("pg")
  const [url, action, name] = process.argv.slice(1)
  // The builtin collation provider, as in CI and production, whatever the server default is.
  // Quoted names, not string literals: this script sits in single quotes.
  const create = `create database "${name}" template template0 encoding UTF8 locale_provider builtin builtin_locale "C.UTF-8" locale "C.UTF-8"`
  const sql = {
    create,
    drop: `drop database if exists "${name}" with (force)`,
    list: "select datname from pg_database where starts_with(datname, $1) order by 1",
  }[action]
  const client = new Client({ connectionString: url })
  client.connect()
    .then(() => client.query(sql, action === "list" ? [name] : []))
    .then((result) => action === "list" && result.rows.forEach((row) => console.log(row.datname)))
    .then(() => client.end())
    .catch((error) => {
      console.error(error.message)
      process.exit(1)
    })
' "$1" "$2" "$3"
