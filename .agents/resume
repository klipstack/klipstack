#!/usr/bin/env bash
# Runs each time an Amp orb starts or wakes: makes sure PostgreSQL (from .agents/setup) is up.
set -euo pipefail

if ! pg_isready -q -h localhost -p 5433; then
	sudo systemctl start postgresql@17-klipstack
	for _ in $(seq 1 8); do pg_isready -q -h localhost -p 5433 && break; sleep 1; done
fi
pg_isready -h localhost -p 5433
