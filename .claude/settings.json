{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-hook.mjs\" claude"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-hook.mjs\" claude"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-hook.mjs\" claude"
					}
				]
			}
		]
	}
}
