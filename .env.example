# --- required ---
DATABASE_URL=postgres://klipstack:klipstack@localhost:5433/klipstack
# Connections per process (web and worker each have a pool). Optional; default 10.
# PG_POOL_MAX=10
# at least 32 chars in production: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-to-a-random-string-of-at-least-32-chars
APP_URL=http://localhost:5180
# Only these proxy addresses may supply forwarding headers. Set the exact Caddy address/subnet
# if it runs in another container. Keep the web port private to that proxy.
TRUST_PROXY=loopback

# --- signup gating ---
# open | invite | waitlist   (invite = requires a code from the `invites` table;
# waitlist = invite, plus a public form at /request-invite)
SIGNUP_MODE=invite

# Per-account caps, the same for every account but admins' AI cap.
# Unset means these defaults.
# LIMIT_SAVES_PER_MONTH=300
# LIMIT_STORAGE_MB=250
# LIMIT_FEEDS=100
# LIMIT_EDITIONS_PER_MONTH=4
# LIMIT_SHARES_PER_MONTH=100
# LIMIT_AI_PER_MONTH=100
# LIMIT_AI_PER_MONTH_ADMIN=500
# LIMIT_TOPICS_PER_MONTH=100
# LIMIT_TOPIC_SORTS_PER_MONTH=1000

# --- AI answers in the reader (optional; off without a key) ---
# docs/self-hosting/ai.md. AI_FAKE=1 answers with a fixed text instead, without calling anyone.
ANTHROPIC_API_KEY=
# With Anthropic's key, automatic topics (the worker uses both).
TYPESAFE_API_KEY=
# AI_FAKE=1

# --- email (optional; falls back to console transport in dev) ---
RESEND_API_KEY=
EMAIL_FROM="Klipstack <hello@example.com>"
# A welcome for new accounts, signed by a person: a note on Home and an email once the address is
# verified. Off unless both the name and the address are set; the photo is optional (https or /path).
WELCOME_FROM_NAME=
WELCOME_FROM_EMAIL=
WELCOME_FROM_PHOTO=

# --- oauth (optional; provider hidden when unset) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- iPhone app links (optional; off when unset) ---
# Only for a server with its own build of the iPhone app: the Apple team ID (10 characters) and the
# app's bundle ID. Unset, /.well-known/apple-app-site-association answers 404.
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_BUNDLE_ID=com.example.app

# --- storage: fs (dev only, single machine) | s3 (Cloudflare R2 / S3; required in production) ---
# Unset, it is fs, in production too: set it there explicitly.
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Keep the bucket private. Images are served through the app after checking ownership.
S3_REGION=auto

# Optional: Better Stack team pages linked from /admin/system (plain https dashboard URLs, never a
# heartbeat ping URL). Unset, the links open https://uptime.betterstack.com/.
# OPS_UPTIME_URL=https://uptime.betterstack.com/team/<team>/monitors
# OPS_BACKUPS_URL=https://uptime.betterstack.com/team/<team>/heartbeats

# Optional: a SuppyHQ account (the tenant in its embed snippet). The sidebar then offers Contact
# support, which opens SuppyHQ's contact form. Unset, the app has no link to SuppyHQ.
# SUPPYHQ_TENANT=<your-tenant>
